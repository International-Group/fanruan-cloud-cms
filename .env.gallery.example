# Merge these settings into the existing Strapi environment; preserve existing keys.
GALLERY_ACCOUNT_API_URL=http://localhost:8000
GALLERY_PUBLIC_URL=http://localhost:1337/api
GALLERY_REVIEWER_IDS=
# Generate once: openssl rand -hex 32 (keep stable across instances/restarts)
GALLERY_ASSET_SECRET=
# local (development / legacy files) or s3 (production).
GALLERY_STORAGE_PROVIDER=local
# Required in S3 mode: a PRIVATE bucket with all 4 Block Public Access settings.
# Reuses AWS_ACCESS_KEY_ID / AWS_ACCESS_SECRET / AWS_SESSION_TOKEN, or the IAM role.
GALLERY_S3_BUCKET=
# Empty defaults to AWS_REGION.
GALLERY_S3_REGION=
GALLERY_S3_PREFIX=gallery-private
# Only local mode / unmigrated legacy files need this persistent directory.
GALLERY_STORAGE_DIR=./runtime/gallery-assets

# Gallery review result emails (reuse account-service SMTP values).
GALLERY_SITE_URL=http://localhost:3000
GALLERY_MAIL_ENABLED=false
GALLERY_MAIL_HOST=
GALLERY_MAIL_PORT=465
GALLERY_MAIL_SECURE=true
GALLERY_MAIL_USER=
GALLERY_MAIL_PASS=
GALLERY_MAIL_FROM=

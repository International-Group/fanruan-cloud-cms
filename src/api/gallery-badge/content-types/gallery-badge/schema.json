{
  "kind": "collectionType",
  "collectionName": "gallery_badges",
  "info": {
    "singularName": "gallery-badge",
    "pluralName": "gallery-badges",
    "displayName": "Gallery 作者勋章"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "code": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 64
    },
    "nameZhTw": {
      "type": "string",
      "maxLength": 80
    },
    "nameKo": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "color": {
      "type": "enumeration",
      "enum": [
        "blue",
        "green",
        "purple",
        "gold",
        "gray"
      ],
      "default": "blue",
      "required": true
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "creators": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::gallery-creator.gallery-creator",
      "mappedBy": "badges",
      "private": true
    }
  },
  "indexes": [
    {
      "name": "gallery_badges_code_uq",
      "columns": [
        "code"
      ],
      "type": "unique"
    }
  ],
  "config": {
    "settings": {
      "bulkable": true,
      "filterable": true,
      "searchable": true,
      "pageSize": 25,
      "defaultSortBy": "name",
      "defaultSortOrder": "ASC",
      "mainField": "name"
    },
    "layouts": {
      "list": [
        "name",
        "code",
        "color",
        "enabled"
      ],
      "edit": [
        [
          {
            "name": "name",
